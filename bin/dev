#!/bin/bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

source $SCRIPT_DIR/.devenv

export PORT=4000

cd $SCRIPT_DIR && lein clean
cd $SCRIPT_DIR/..

mongod --dbpath ./dev-db &
MONGO_PID=$!

lein repl :headless &
REPL_PID=$!

lein fig:build &
FIG_PID=$!

trap 'kill $MONGO_PID $REPL_PID $FIG_PID 2>/dev/null' EXIT INT TERM

wait
